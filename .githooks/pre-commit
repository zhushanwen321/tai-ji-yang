#!/bin/bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

node scripts/check-all.mjs --static

# lib 产物新鲜度（FF16 防复发支）：改 client/ 或 index.js 未重 build 即拦截——
# 判定与 doctor lib-fresh 同源（scripts/verify/lib/freshness.mjs），漏 build 的 commit
# 不再拖到真机验收才红。恢复动作：先 pnpm build 再提交。
node scripts/check-lib-fresh.mjs

if git diff --cached --name-only | grep -q '^\.agents/workflows/'; then
  BUILDER=.agents/workflows/scripts/build-workflows.mjs
  if [ ! -f "$BUILDER" ]; then
    printf 'workflow 文件已暂存但构建器缺失：%s。恢复：先接入 .agents/workflows 单源构建体系再提交。\n' "$BUILDER" >&2
    exit 1
  fi
  node "$BUILDER" --check
  node --test .agents/workflows/tests/*.test.mjs
fi
