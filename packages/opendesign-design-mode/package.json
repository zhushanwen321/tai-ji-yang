{
  "name": "opendesign-design-mode",
  "version": "0.1.0",
  "description": "OpenDesign design-mode preset, preview panel and artifact pipeline as a DeepSeek Harness (DSH) plugin",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhushanwen321/tai-ji-yang.git",
    "directory": "packages/opendesign-design-mode"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./client-entry": {
      "default": "./lib/client-entry.js"
    },
    "./persona": {
      "default": "./lib/persona.js"
    },
    "./commands/doctor": {
      "default": "./lib/commands/doctor.js"
    },
    "./serve/artifacts-route": {
      "default": "./lib/serve/artifacts-route.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
